# Pulp API configuration for development
# Copy this to .env.local and configure for your Pulp instance

# Pulp API base URL (default: http://localhost:8080)
VITE_PULP_API_URL=http://localhost:8080

# Pulp API base path (default: /pulp/api/v3/)
VITE_PULP_API_BASE_PATH=/pulp/api/v3/

# Enable debug logging (true/false)
VITE_DEBUG=false
